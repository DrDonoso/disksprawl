# DiskSprawl settings for docker-compose.yml. Copy this file as .env next to it; every variable is
# optional. After a change, run `docker compose up -d` (a plain restart keeps the old values).
# docs/configuration.md describes each one in detail.

# Image tag to run: latest, or a CalVer release such as 20261115 to update only when you decide
# (https://github.com/DrDonoso/disksprawl/releases).
IMAGE_TAG=latest

# Host address the web interface is published on. 0.0.0.0 (every interface) lets the other devices
# of your network open it; 127.0.0.1 limits it to this machine, for example behind a reverse proxy
# on the same host.
APP_BIND_ADDRESS=0.0.0.0
# Host port; the container always listens on 7780.
APP_PORT=7780

# IANA time zone of the schedules ("daily at 03:00" is 03:00 in this zone), such as Europe/Madrid
# or America/New_York.
TZ=Etc/UTC

# Optional single password for the web interface, at least 12 characters. Empty: anyone who can
# reach the port can use DiskSprawl (it only reads your folders, but it shows their names).
AUTH_PASSWORD=
# Key that signs the session cookies, at least 32 characters; generate it with
# `openssl rand -hex 32`. Empty: a random key is created once in the data volume.
AUTH_SECRET=
# true when DiskSprawl is opened over HTTPS (behind a reverse proxy): the session cookie is then
# sent over HTTPS only, and browsers are told to always use HTTPS. Keep false for plain http://.
AUTH_COOKIE_SECURE=false
# Hours a sign-in lasts (1-8760).
SESSION_HOURS=168

# Extra host names DiskSprawl answers to, comma-separated, such as disks.example.com (a leading dot
# allows subdomains: .example.com). IP addresses, localhost, single names (nas) and local names
# (.local, .lan, .home.arpa, .internal…) always work. Any other name, for example the domain of a
# reverse proxy, must be listed here: this blocks DNS rebinding attacks. * allows every name.
ALLOWED_HOSTS=

# Reverse proxies whose X-Forwarded-For/Proto headers are trusted: comma-separated IP addresses or
# networks as the container sees them (a proxy in another container connects from the Compose
# network, such as 172.18.0.1). Never use * or a network untrusted clients can use.
TRUSTED_PROXY_IPS=127.0.0.1
